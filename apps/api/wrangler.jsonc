{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dentivohq-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_ENV": "development",
    "CORS_ORIGINS": "http://localhost:4321,http://localhost:5173,http://localhost:5174"
  },
  "r2_buckets": [
    { "binding": "UPLOADS", "bucket_name": "dentivohq-uploads", "preview_bucket_name": "dentivohq-uploads-preview" }
  ],
  "ratelimits": [
    { "name": "PUBLIC_BOOKING_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "env": {
    "preview": {
      "name": "dentivohq-api-preview",
      "vars": {
        "APP_ENV": "staging",
        "CORS_ORIGINS": "https://replace-with-preview-pages-domain.invalid"
      },
      "r2_buckets": [
        { "binding": "UPLOADS", "bucket_name": "dentivohq-uploads-preview" }
      ],
      "ratelimits": [
        { "name": "PUBLIC_BOOKING_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
      ],
      "triggers": { "crons": ["* * * * *"] },
      "observability": { "enabled": true, "head_sampling_rate": 1 }
    }
  }
}
