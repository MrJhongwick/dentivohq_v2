# Server-only values. Never use VITE_ or PUBLIC_ prefixes for these.
DATABASE_URL=postgresql://dentivohq:dentivohq_local@localhost:5432/dentivohq
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:8787
APP_DASHBOARD_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=DentivoHQ <appointments@example.com>
CORS_ORIGINS=http://localhost:4321,http://localhost:5173,http://localhost:5174
APP_ENV=development

# Browser-safe values. Copy only these into frontend-specific .env files.
PUBLIC_DASHBOARD_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8787
VITE_API_URL=http://localhost:8787

# Cloudflare R2 uses an in-process UPLOADS binding configured in wrangler.jsonc.
